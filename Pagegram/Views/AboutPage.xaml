<Page
    x:Class="Pagegram.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled"
    Background="Black">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12,12,12,24">
            <TextBlock Text="О ПРОГРАММЕ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="96" Height="96" Source="ms-appx:///Assets/Square150x150Logo.png" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pagegram" FontSize="26" Foreground="White" />
                    <TextBlock x:Name="Version" FontSize="14" Foreground="#FF8A8A8A" />
                </StackPanel>
            </Grid>
            <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="15"
                       Text="Лёгкий неофициальный клиент Telegram для Windows 10 Mobile, рассчитанный на телефоны с 512 МБ – 1 ГБ памяти. Работает на TDLib — официальной библиотеке Telegram." />
        </StackPanel>
    </ScrollViewer>
</Page>
