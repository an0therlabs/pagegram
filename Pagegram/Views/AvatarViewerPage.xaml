<Page
    x:Class="Pagegram.Views.AvatarViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Disabled"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="12,10,12,8">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" Foreground="White"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="CounterText" FontSize="13" Foreground="#FF8A8A8A" />
        </StackPanel>

        <!-- FlipView держит в памяти только соседние слайды -->
        <FlipView x:Name="Flip" Grid.Row="1" ItemsSource="{x:Bind Slides}" Background="Black"
                  SelectionChanged="OnSelectionChanged">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="m:AvatarSlide">
                    <Grid>
                        <ProgressRing IsActive="True" Width="40" Height="40" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <TextBlock x:Name="Hint" Grid.Row="1" Foreground="#FF8A8A8A" Text="загрузка…"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
