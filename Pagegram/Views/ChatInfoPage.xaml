<Page
    x:Class="Pagegram.Views.ChatInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Disabled"
    Background="Black">

    <!-- Вся страница — один GridView: сетка фото виртуализируется, а инфо о чате — его заголовок -->
    <GridView x:Name="PhotoGrid" ItemsSource="{x:Bind Photos}" Padding="12,0,12,12"
              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPhotoClick"
              ShowsScrollingPlaceholders="False" SizeChanged="OnGridSizeChanged">
        <GridView.Header>
            <StackPanel Padding="0,12,0,8">
                <TextBlock Text="ИНФОРМАЦИЯ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96">
                        <Ellipse Fill="{x:Bind Chat.AvatarBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Chat.Initial, Mode=OneWay}" FontSize="40" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind Chat.Photo, Mode=OneWay}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="22" Foreground="White" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock x:Name="SubtitleText" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="UsernameRow" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Имя пользователя" FontSize="18" Foreground="White" />
                    <TextBlock x:Name="UsernameText" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel x:Name="PhoneRow" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Телефон" FontSize="18" Foreground="White" />
                    <TextBlock x:Name="PhoneText" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel x:Name="AboutRow" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock x:Name="AboutLabel" Text="Описание" FontSize="18" Foreground="White" />
                    <TextBlock x:Name="AboutText" FontSize="14" Foreground="#FFCCCCCC" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>

                <TextBlock Text="ФОТО" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,10,0,8" />
                <TextBlock x:Name="PhotosHint" Text="загрузка…" FontSize="14" Foreground="#FF8A8A8A" />
            </StackPanel>
        </GridView.Header>

        <GridView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="2" />
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="m:MediaThumb">
                <Grid Background="#FF262626">
                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="UniformToFill" />
                </Grid>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</Page>
