<Page
    x:Class="Pagegram.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    xmlns:local="using:Pagegram.Views"
    NavigationCacheMode="Disabled"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: тёмная полоса, маленькая круглая аватарка, название капсом, подзаголовок серым -->
        <!-- Тап по шапке (аватарка/название) — информация о чате -->
        <Grid Background="#FF1F1F1F" Padding="12,8" Tapped="OnHeaderTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Center">
                <Ellipse Fill="{x:Bind Chat.AvatarBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Chat.Initial, Mode=OneWay}" FontSize="18" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{x:Bind Chat.Photo, Mode=OneWay}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Title" FontSize="17" FontWeight="Bold" Foreground="White"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="Subtitle" FontSize="13" Foreground="#FF8A8A8A"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </Grid>

        <ListView x:Name="MessageList" Grid.Row="1"
                  ItemsSource="{x:Bind Messages}"
                  SelectionMode="None" IsItemClickEnabled="False"
                  ShowsScrollingPlaceholders="False">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- держит низ списка на месте, когда сверху догружается история -->
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:MessageItem">
                    <!-- [аватарка] [◣] [пузырь] [◢] — хвостик сбоку у нижнего угла, со стороны отправителя.
                         Входящие белые, исходящие светло-серые, текст чёрный, время серое внутри. -->
                    <Grid>
                    <!-- Стрелка «ответить» — проявляется, пока тянешь сообщение влево -->
                    <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0" />
                    <!-- Свайп влево = ответить: пузырь едет за пальцем, вертикальная прокрутка остаётся у списка -->
                    <Grid HorizontalAlignment="{x:Bind Alignment}" Margin="0,3"
                          ManipulationMode="TranslateX,TranslateRailsX,System"
                          ManipulationDelta="OnBubbleDelta" ManipulationCompleted="OnBubbleCompleted">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="36" Height="36" Margin="0,0,4,0" VerticalAlignment="Bottom"
                              Visibility="{x:Bind AvatarVisibility}">
                            <Ellipse Fill="{x:Bind AvatarBrush}" />
                            <TextBlock Text="{x:Bind AvatarInitial}" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <Path Grid.Column="1" Data="M8,0 L8,10 L0,10 Z" Fill="{x:Bind Background}"
                              VerticalAlignment="Bottom" Visibility="{x:Bind InTailVisibility}" />

                        <StackPanel Grid.Column="2" MaxWidth="280" Background="{x:Bind Background}" Padding="8,5,8,4">
                            <TextBlock Text="{x:Bind Sender}" Visibility="{x:Bind SenderVisibility}"
                                       FontSize="15" FontWeight="SemiBold" Foreground="{x:Bind SenderBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <!-- Ответ: плашка-цитата; тап — прокрутить к исходному сообщению -->
                            <Border Visibility="{x:Bind ReplyVisibility}" BorderThickness="3,0,0,0" BorderBrush="White"
                                    Background="#22FFFFFF" Padding="8,3" Margin="0,2,0,4" Tapped="OnReplyQuoteTapped">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ReplySender, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind ReplyText, Mode=OneWay}" FontSize="13" Foreground="White" Opacity="0.8"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Border>
                            <!-- Голосовое: круглая кнопка ▶/❚❚, полоса прогресса, время -->
                            <Grid Visibility="{x:Bind VoiceVisibility}" Width="230" Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="42" Height="42" Tapped="OnVoiceTapped">
                                    <Ellipse Fill="White" />
                                    <TextBlock Text="{x:Bind VoiceGlyph, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{x:Bind Background}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ProgressBar Value="{x:Bind VoiceProgress, Mode=OneWay}" Maximum="1" Height="4"
                                                 Foreground="White" Background="#4DFFFFFF" />
                                    <TextBlock Text="{x:Bind VoiceTimeText, Mode=OneWay}" FontSize="12" Foreground="White"
                                               Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" MaxLines="3" />
                                </StackPanel>
                            </Grid>
                            <!-- Кружок: превью в круге; по тапу в Border-слот вешается Composition-визуал
                                 с видео, обрезанным маской-кругом (настоящий круг, прозрачные края) -->
                            <Grid Width="200" Height="200" Visibility="{x:Bind NoteVisibility}" Tapped="OnVideoNoteTapped"
                                  RenderTransformOrigin="{x:Bind NoteOrigin}" Margin="0,2,0,2">
                                <Grid.RenderTransform>
                                    <ScaleTransform />
                                </Grid.RenderTransform>
                                <Ellipse Fill="#FF262626" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{x:Bind Media, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Border IsHitTestVisible="False" />
                                <Border Background="#99000000" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="0,0,0,10" IsHitTestVisible="False">
                                    <TextBlock Text="{x:Bind VideoNoteDuration}" FontSize="12" Foreground="White" />
                                </Border>
                            </Grid>
                            <!-- Фото/стикер. Размер задан заранее, чтобы лента не прыгала при загрузке -->
                            <Image Source="{x:Bind Media, Mode=OneWay}" Visibility="{x:Bind MediaVisibility}"
                                   Width="{x:Bind MediaWidth}" Height="{x:Bind MediaHeight}" Stretch="Uniform"
                                   Margin="0,1,0,2" HorizontalAlignment="Left" Tapped="OnPhotoTapped" />
                            <!-- Текст: @username, ссылки и почта — синие и кликабельные -->
                            <TextBlock local:RichText.Content="{x:Bind Rich, Mode=OneWay}" Visibility="{x:Bind TextVisibility, Mode=OneWay}"
                                       TextWrapping="Wrap" Foreground="White" FontSize="16" />
                            <TextBlock Text="{x:Bind Footer, Mode=OneWay}" FontSize="12" Foreground="{x:Bind FooterForeground}"
                                       HorizontalAlignment="Right" Margin="12,1,0,0" />
                            <!-- Комментарии к посту канала: заметная полоса во всю ширину пузыря -->
                            <Button Visibility="{x:Bind CommentsVisibility, Mode=OneWay}" Click="OnCommentsClick"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#40FFFFFF"
                                    Padding="0,8,0,4" Margin="0,6,0,0" MinWidth="200">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CommentsText, Mode=OneWay}" Margin="10,0,8,0"
                                               FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="White" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Path Grid.Column="3" Data="M0,0 L8,10 L0,10 Z" Fill="{x:Bind Background}"
                              VerticalAlignment="Bottom" Visibility="{x:Bind OutTailVisibility}" />
                    </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- В канале без права публикации вместо ввода — полоса «выключить/включить уведомления» -->
        <!-- «Ответ на…» над полем ввода -->
        <Grid x:Name="ReplyBar" Grid.Row="2" Visibility="Collapsed" Background="#FF1F1F1F" Padding="12,6,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border BorderThickness="3,0,0,0" BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}" Padding="8,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="ReplyBarSender" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="ReplyBarText" FontSize="13" Foreground="#FFCCCCCC" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="40" Height="36"
                    Padding="0" BorderThickness="0" Background="Transparent" Foreground="White" Click="OnCancelReply" />
        </Grid>

        <Button x:Name="MuteBar" Grid.Row="3" Visibility="Collapsed" Click="OnToggleMute"
                HorizontalAlignment="Stretch" Height="52" BorderThickness="0" Background="#FF1F1F1F"
                Foreground="{ThemeResource SystemControlForegroundAccentBrush}" FontSize="15" FontWeight="SemiBold" />

        <!-- Панель ввода: тёмная полоса, поле без рамки, плоская иконка отправки -->
        <Grid x:Name="InputBar" Grid.Row="3" Background="#FF1F1F1F" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" PlaceholderText="Сообщение" TextWrapping="Wrap" AcceptsReturn="True"
                     MaxHeight="120" InputScope="Chat" BorderThickness="0" Background="Transparent"
                     Foreground="White" VerticalAlignment="Center" />
            <Button x:Name="SendButton" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                    Click="OnSend" Content="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                    Width="44" Height="40" Padding="0" BorderThickness="0" Background="Transparent"
                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
        </Grid>
    </Grid>
</Page>
