<Page
    x:Class="Pagegram.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Disabled"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Title" FontSize="20" FontWeight="SemiBold" Margin="12,8"
                   TextTrimming="CharacterEllipsis" MaxLines="1" />

        <ListView x:Name="MessageList" Grid.Row="1"
                  ItemsSource="{x:Bind Messages}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnMessageClick"
                  ShowsScrollingPlaceholders="False">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- держит низ списка на месте, когда сверху догружается история -->
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:MessageItem">
                    <!-- минимум элементов на сообщение: Border + StackPanel + 3 TextBlock -->
                    <Border HorizontalAlignment="{x:Bind Alignment}" Background="{x:Bind Background}"
                            CornerRadius="6" Padding="8,4" MaxWidth="320">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Sender}" Visibility="{x:Bind SenderVisibility}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#FF7AB8F5"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" Foreground="White" />
                            <TextBlock Text="{x:Bind Footer, Mode=OneWay}" FontSize="11" Opacity="0.6"
                                       HorizontalAlignment="Right" Foreground="White" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" PlaceholderText="Сообщение" TextWrapping="Wrap" AcceptsReturn="True"
                     MaxHeight="120" InputScope="Chat" />
            <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom"
                    Click="OnSend" Content="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                    Width="48" Height="32" Padding="0" />
        </Grid>
    </Grid>
</Page>
