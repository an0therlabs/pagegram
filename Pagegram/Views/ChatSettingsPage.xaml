<Page
    x:Class="Pagegram.Views.ChatSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled"
    Background="Black">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12,12,12,24">
            <TextBlock Text="НАСТРОЙКИ ЧАТОВ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

            <TextBlock Text="Размер текста сообщений" FontSize="16" Foreground="White" />
            <Slider x:Name="FontSlider" Minimum="13" Maximum="22" StepFrequency="1" Margin="0,4,0,4" ValueChanged="OnFontChanged" />
            <!-- Пример пузыря с выбранным размером -->
            <Border Background="#FF333333" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,20">
                <TextBlock x:Name="Preview" Text="Так будут выглядеть сообщения" Foreground="White" TextWrapping="Wrap" />
            </Border>

            <ToggleSwitch x:Name="AutoPhotos" Header="Автозагрузка фото в чатах" OnContent="включена" OffContent="выключена"
                          Toggled="OnAutoPhotosToggled" />
            <TextBlock Text="Выключите, чтобы экономить трафик и память: фото будут открываться по тапу."
                       FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,0,0,20" />

            <TextBlock Text="ПАМЯТЬ" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
            <TextBlock x:Name="CacheText" Foreground="White" FontSize="15" Text="подсчёт…" />
            <TextBlock x:Name="DbText" Foreground="#FF8A8A8A" FontSize="13" Margin="0,2,0,10" />
            <Button Content="Очистить кэш" Click="OnClearCache" HorizontalAlignment="Stretch" />
            <TextBlock Text="Удаляет скачанные фото, стикеры, голосовые и аватарки. Сообщения остаются."
                       FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
