<Page
    x:Class="Pagegram.Views.ChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,8,12,8">
            <TextBlock Text="PAGEGRAM" FontSize="13" FontWeight="SemiBold" CharacterSpacing="40" Opacity="0.8" />
            <TextBlock x:Name="Header" Text="чаты" FontSize="46" FontWeight="SemiLight" Margin="-3,-4,0,0" />
        </StackPanel>

        <!-- Фиксированная высота строки + простой шаблон = нормальная виртуализация на слабом железе -->
        <ListView x:Name="ChatList" Grid.Row="1"
                  ItemsSource="{x:Bind Chats}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnChatClick"
                  ShowsScrollingPlaceholders="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="MinHeight" Value="68" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:ChatItem">
                    <Grid Height="68">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Ellipse Grid.RowSpan="2" Width="48" Height="48" Fill="{x:Bind AvatarBrush}" />
                        <TextBlock Grid.RowSpan="2" Text="{x:Bind Initial, Mode=OneWay}" FontSize="22" FontWeight="SemiLight"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        <Ellipse Grid.RowSpan="2" Width="48" Height="48">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind Photo, Mode=OneWay}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                   Text="{x:Bind Title, Mode=OneWay}" FontSize="19" FontWeight="SemiLight"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom" FontSize="12" Opacity="0.6"
                                   Text="{x:Bind Time, Mode=OneWay}" />

                        <TextBlock Grid.Column="1" Grid.Row="1" Margin="10,2,0,0" VerticalAlignment="Top" Opacity="0.7"
                                   Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <Border Grid.Column="2" Grid.Row="1" Margin="8,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                                MinWidth="22" Height="22" Padding="6,0"
                                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                Visibility="{x:Bind UnreadVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind UnreadText, Mode=OneWay}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar ClosedDisplayMode="Minimal">
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Очистить кэш" Click="OnClearCache" />
                <AppBarButton Label="Выйти из аккаунта" Click="OnLogout" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
