<Page
    x:Class="Pagegram.Views.EditProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled"
    Background="Black">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12,12,12,24">
            <TextBlock Text="ИЗМЕНИТЬ ПРОФИЛЬ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />
            <TextBox x:Name="FirstName" Header="Имя" Margin="0,0,0,12" InputScope="PersonalFullName" />
            <TextBox x:Name="LastName" Header="Фамилия" Margin="0,0,0,12" InputScope="PersonalFullName" />
            <TextBox x:Name="Bio" Header="О себе" Margin="0,0,0,4" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="70" />
            <TextBlock Text="Пара слов о себе, до 70 символов" FontSize="13" Foreground="#FF8A8A8A" Margin="0,0,0,12" />
            <TextBox x:Name="UsernameBox" Header="Имя пользователя" Margin="0,0,0,4" />
            <TextBlock Text="По нему вас найдут без номера телефона: @имя. Можно оставить пустым."
                       FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,0,0,18" />
            <Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="Error" Foreground="#FFE57373" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
