<Page
    x:Class="Pagegram.Views.ForwardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Disabled"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="ПЕРЕСЛАТЬ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="12,12,12,8" />
        <TextBox x:Name="Filter" Grid.Row="1" Margin="12,0,12,8" PlaceholderText="Кому переслать" TextChanged="OnFilterChanged" />

        <ListView Grid.Row="2" ItemsSource="{x:Bind Shown}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnChatClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="MinHeight" Value="60" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:ChatItem">
                    <Grid Height="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="42" Height="42" Fill="{x:Bind AvatarBrush}" />
                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="42" Height="42">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind Photo, Mode=OneWay}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" Foreground="White"
                                   Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
