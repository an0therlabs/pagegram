<Page
    x:Class="Pagegram.Views.PhotoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled"
    Background="Black">
    <Grid>
        <ScrollViewer ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="Img" Stretch="Uniform" />
        </ScrollViewer>
        <ProgressRing x:Name="Ring" IsActive="True" Width="48" Height="48" />
        <TextBlock x:Name="Error" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
    </Grid>
</Page>
