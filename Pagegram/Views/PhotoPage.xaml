<Page
    x:Class="Pagegram.Views.PhotoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Disabled"
    Background="Black">

    <Grid>
        <!-- Свайп влево/вправо — соседние фото. Держит в памяти только ближайшие слайды -->
        <FlipView x:Name="Flip" ItemsSource="{x:Bind Slides}" Background="Black" SelectionChanged="OnSelectionChanged">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="m:PhotoSlide">
                    <Grid>
                        <ProgressRing IsActive="True" Width="40" Height="40" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                        <!-- Фото вписано в экран: Image ровно размером видимой области, зум — средствами ScrollViewer -->
                        <ScrollViewer x:Name="Zoom" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                                      DoubleTapped="OnDoubleTapped" Tapped="OnTapped">
                            <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform"
                                   Width="{Binding ViewportWidth, ElementName=Zoom}"
                                   Height="{Binding ViewportHeight, ElementName=Zoom}" />
                        </ScrollViewer>
                    </Grid>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <!-- Верхняя панель: счётчик и «сохранить». Тап по фото — спрятать/показать -->
        <Grid x:Name="Bar" VerticalAlignment="Top" Background="#B3000000" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Counter" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="OnSave" Padding="8,4" BorderThickness="0" Background="Transparent" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="сохранить" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
