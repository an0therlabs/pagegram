<Page
    x:Class="Pagegram.Views.ProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled"
    Background="Black">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12,12,12,24">
            <TextBlock Text="ПРОКСИ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
            <TextBlock Text="Если Telegram заблокирован. Тап по прокси — включить его или выключить."
                       FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,0,0,12" />

            <!-- Список добавленных прокси -->
            <StackPanel x:Name="List" />
            <TextBlock x:Name="Empty" Text="Прокси не добавлены — подключение напрямую." FontSize="14" Foreground="#FF8A8A8A"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <Button x:Name="DisableButton" Content="Подключаться напрямую (выключить прокси)" Click="OnDisable"
                    HorizontalAlignment="Stretch" Margin="0,4,0,20" Visibility="Collapsed" />

            <!-- По ссылке tg://proxy… или t.me/proxy… -->
            <TextBlock Text="ДОБАВИТЬ ПО ССЫЛКЕ" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
            <TextBox x:Name="LinkBox" PlaceholderText="tg://proxy?server=…  или  https://t.me/proxy?…" Margin="0,0,0,8" InputScope="Url" />
            <Button Content="Добавить по ссылке" Click="OnAddLink" HorizontalAlignment="Stretch" Margin="0,0,0,20" />

            <!-- Вручную -->
            <TextBlock Text="ДОБАВИТЬ ВРУЧНУЮ" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
            <Button Content="Заготовка для tg-ws-proxy" Click="OnPresetWs" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
            <TextBlock Text="tg-ws-proxy (на ПК или роутере в вашей сети) — это MTProto-прокси, по умолчанию порт 1443. Укажите адрес устройства, где он запущен (например 192.168.1.10), и секрет из его настроек."
                       FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,0,0,12" />

            <ComboBox x:Name="TypeBox" Header="Тип" HorizontalAlignment="Stretch" Margin="0,0,0,12" SelectionChanged="OnTypeChanged">
                <x:String>MTProto</x:String>
                <x:String>SOCKS5</x:String>
                <x:String>HTTP</x:String>
            </ComboBox>
            <TextBox x:Name="ServerBox" Header="Сервер" PlaceholderText="адрес или домен" Margin="0,0,0,12" InputScope="Url" />
            <TextBox x:Name="PortBox" Header="Порт" Margin="0,0,0,12" InputScope="Number" />
            <TextBox x:Name="SecretBox" Header="Секрет (hex)" Margin="0,0,0,12" />
            <TextBox x:Name="UserBox" Header="Пользователь (необязательно)" Margin="0,0,0,12" Visibility="Collapsed" />
            <PasswordBox x:Name="PassBox" Header="Пароль (необязательно)" Margin="0,0,0,12" Visibility="Collapsed" />
            <Button Content="Добавить и включить" Click="OnAddManual" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="Error" Foreground="#FFE57373" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
