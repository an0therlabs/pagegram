<Page
    x:Class="Pagegram.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Disabled"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="ПОИСК" FontSize="18" FontWeight="Bold" Foreground="White" Margin="12,12,12,8" />
        <TextBox x:Name="Query" Grid.Row="1" Margin="12,0,12,8" PlaceholderText="Чаты, каналы, люди"
                 InputScope="Search" TextChanged="OnQueryChanged" />

        <Grid Grid.Row="2">
            <ListView ItemsSource="{x:Bind Results}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnResultClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:ChatItem">
                        <Grid Height="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="44" Height="44" Fill="{x:Bind AvatarBrush}" />
                            <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="44" Height="44">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind Photo, Mode=OneWay}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="18" Foreground="White"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind Preview, Mode=OneWay}" FontSize="14" Foreground="#FF8A8A8A"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Hint" Margin="12" Foreground="#FF8A8A8A" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
