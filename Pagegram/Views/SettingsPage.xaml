<Page
    x:Class="Pagegram.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled"
    Background="Black">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12,12,12,24">
            <TextBlock Text="НАСТРОЙКИ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

            <!-- Профиль -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72">
                    <Ellipse x:Name="AvatarCircle" />
                    <TextBlock x:Name="AvatarInitial" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarImage" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="22" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="в сети" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                </StackPanel>
            </Grid>

            <!-- Номер и имя пользователя -->
            <TextBlock Text="Телефон" FontSize="16" Foreground="#FF8A8A8A" />
            <TextBlock x:Name="Phone" FontSize="17" Foreground="White" Margin="0,0,0,10" IsTextSelectionEnabled="True" />
            <TextBlock Text="Имя пользователя" FontSize="16" Foreground="#FF8A8A8A" />
            <TextBlock x:Name="Username" FontSize="17" Foreground="White" Margin="0,0,0,18" IsTextSelectionEnabled="True" />

            <!-- Разделы, как в классическом клиенте -->
            <Button Click="OnEditProfile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Изменить профиль" FontSize="18" Foreground="White" />
                        <TextBlock Text="имя, фамилия, о себе, имя пользователя" FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Click="OnPrivacy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Конфиденциальность" FontSize="18" Foreground="White" />
                        <TextBlock Text="последний визит, номер, фото, звонки, группы" FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Click="OnSessions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Активные сеансы" FontSize="18" Foreground="White" />
                        <TextBlock Text="устройства, где открыт ваш аккаунт" FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Click="OnProxy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Прокси" FontSize="18" Foreground="White" />
                        <TextBlock Text="MTProto, SOCKS5, HTTP, tg-ws-proxy" FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Click="OnChatSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Настройки чатов" FontSize="18" Foreground="White" />
                        <TextBlock Text="размер текста, автозагрузка фото, память" FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Click="OnAbout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="О программе" FontSize="18" Foreground="White" />
                        <TextBlock Text="версия и диагностика" FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Content="Выйти из аккаунта" Click="OnLogout" HorizontalAlignment="Stretch" Margin="0,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
