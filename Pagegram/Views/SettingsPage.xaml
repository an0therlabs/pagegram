<Page
    x:Class="Pagegram.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled"
    Background="Black">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12,12,12,24">
            <TextBlock Text="НАСТРОЙКИ" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

            <!-- Профиль -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72">
                    <Ellipse x:Name="AvatarCircle" />
                    <TextBlock x:Name="AvatarInitial" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarImage" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="22" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="в сети" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Телефон" FontSize="18" Foreground="White" />
            <TextBlock x:Name="Phone" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,0,14" />

            <TextBlock Text="Имя пользователя" FontSize="18" Foreground="White" />
            <TextBlock x:Name="Username" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,0,24" />

            <Button Content="Очистить кэш" Click="OnClearCache" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
            <TextBlock Text="Удаляет скачанные фото, стикеры и аватарки. Сообщения остаются."
                       FontSize="13" Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Button Content="Выйти из аккаунта" Click="OnLogout" HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>
