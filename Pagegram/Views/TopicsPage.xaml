<Page
    x:Class="Pagegram.Views.TopicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pagegram.Models"
    NavigationCacheMode="Disabled"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка как в чате: аватарка группы, название, «темы»; тап — информация -->
        <Grid Background="#FF1F1F1F" Padding="12,8" Tapped="OnHeaderTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Center">
                <Ellipse Fill="{x:Bind Chat.AvatarBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Chat.Initial, Mode=OneWay}" FontSize="18" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{x:Bind Chat.Photo, Mode=OneWay}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" Foreground="White"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="темы" FontSize="13" Foreground="#FF8A8A8A" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="TopicList" ItemsSource="{x:Bind Topics}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnTopicClick" ShowsScrollingPlaceholders="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="MinHeight" Value="68" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:TopicItem">
                        <Grid Height="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Ellipse Grid.RowSpan="2" Width="42" Height="42" Fill="{x:Bind IconBrush}" />
                            <TextBlock Grid.RowSpan="2" Text="{x:Bind Initial}" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Bottom" Text="{x:Bind Title}"
                                       FontSize="18" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom" FontSize="12" Opacity="0.6"
                                       Text="{x:Bind Time}" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Margin="6,2,0,0" VerticalAlignment="Top" Opacity="0.7"
                                       Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <Border Grid.Column="2" Grid.Row="1" Margin="8,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                                    MinWidth="22" Height="22" CornerRadius="11" Padding="6,0"
                                    Background="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="{x:Bind UnreadVisibility}">
                                <TextBlock Text="{x:Bind UnreadText}" FontSize="12" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Hint" Margin="12" Foreground="#FF8A8A8A" TextWrapping="Wrap" Text="загрузка…" />
        </Grid>
    </Grid>
</Page>
